{
  "name": "@afkzona/brightline",
  "version": "0.1.0",
  "description": "Website scanner that finds likely manipulative design (dark patterns) and maps each finding to the EU provision it may breach.",
  "license": "AGPL-3.0-only",
  "author": "MB AFKzona Group",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afkzonagroup/brightline.git"
  },
  "homepage": "https://github.com/afkzonagroup/brightline#readme",
  "bugs": {
    "url": "https://github.com/afkzonagroup/brightline/issues"
  },
  "keywords": [
    "dark-patterns",
    "deceptive-design",
    "consumer-protection",
    "ucpd",
    "consumer-rights-directive",
    "digital-services-act",
    "scanner",
    "playwright"
  ],
  "bin": {
    "brightline": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js"
    },
    "./report.schema.json": "./schema/report.schema.json",
    "./journey.schema.json": "./schema/journey.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "LICENSE-ADDITIONAL-TERMS.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "TRADEMARKS.md",
    "COMMERCIAL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.64.1 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
